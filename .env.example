# Supabase — variables client (exposées au navigateur via VITE_)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Resend — clé API pour l'Edge Function send-contact-email (secret serveur)
RESEND_API_KEY=your_resend_api_key_here

# --- Notes ---
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY : à définir dans le dashboard Vercel
#   (Project Settings → Environment Variables) pour activer la persistance.
# Sans ces variables, le site fonctionne en mode démo (données en local, non persistées).
# RESEND_API_KEY : à définir dans Supabase (Edge Function secrets), pas côté Vercel.
